{
    "extends": "@shega/typescript-config/nextjs.json",
    "compilerOptions": {
        "plugins": [{ "name": "next" }],
        "baseUrl": ".",
        "paths": {
            "@shega/templates": ["src/index.ts"],
            "@shega/templates/*": ["src/*"]
