{
    "extends": "@shega/typescript-config/nextjs.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "allowJs": true,
        "module": "esnext",
        "outDir": "dist",
        "baseUrl": ".",
        "paths": {
            "@/actions/*": ["actions/*"],
            "@/components/*": ["components/*"],
            "@/hooks/*": ["./hooks/*"],
            "@/i18n/*": ["i18n/*"],
            "@/lib/*": ["./lib/*"],
            "@/models/*": ["models/*"]
        },
        "noEmit": true,
        "jsx": "preserve"
    },
    "include": [
        "next-env.d.ts",
        "next.config.js",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "../../../packages/shared/src/types/role.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
