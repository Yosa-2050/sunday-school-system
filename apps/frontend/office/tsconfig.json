{
    "extends": "@shega/typescript-config/nextjs.json",
    "compilerOptions": {
        "plugins": [{ "name": "next" }],
        "allowJs": true,
        "module": "es2015",
        "outDir": "dist",
        "baseUrl": "."
    },
    "include": [
        "next-env.d.ts",
        "next.config.js",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
