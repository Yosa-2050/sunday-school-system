{
    "extends": "@shega/typescript-config/nextjs.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "allowJs": true,
        "module": "esnext",
        "baseUrl": ".",
        "jsx": "preserve",
        "paths": {
            "@/actions/*": ["actions/*"],
            "@/components/*": ["components/*"],
            "@/hooks/*": ["./hooks/*"],
            "@/i18n/*": ["i18n/*"],
            "@/lib/*": ["./lib/*"],
            "@/models/*": ["models/*"],
            "@shega/ui": ["../../../packages/ui/src/index.ts"],
            "@shega/ui/*": ["../../../packages/ui/src/*"],
            "@shega/shared": ["../../../packages/shared/src/index.ts"],
            "@shega/shared/*": ["../../../packages/shared/src/*"]
        },
        "noEmit": true
    },
    "include": [
        "next-env.d.ts",
        "next.config.js",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        "tailwind.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
